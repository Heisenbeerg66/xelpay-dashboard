          <button onClick={onClose}
            className="w-full bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 py-3 rounded-xl text-sm font-medium hover:bg-red-100 dark:hover:bg-red-900/30 transition-all">
            Try Again
          </button>
        </div>
      </div>
    </div>
