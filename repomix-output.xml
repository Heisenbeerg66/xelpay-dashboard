'use client';

import { useState, useEffect } from 'react';
import { Building2, Globe, Smartphone, ShoppingBag, LayoutGrid, Mail, Phone, DollarSign, BadgeDollarSign, ShieldCheck, Copy, Loader2, AlertTriangle, CheckCircle2 } from 'lucide-react';
import { supabase } from '@/lib/supabase';
