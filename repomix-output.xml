        chat_id: bizTg.telegram_chat_id,
        display_name: bizTg.telegram_display_name || null,
        username: bizTg.telegram_username || null,
        is_enabled: bizTg.is_telegram_enabled,
      });
    } else {
      setTelegramData(null);
    }
    setTelegramLoading(false);
  }, [businessId]);

  // Load Device info
