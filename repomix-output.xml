const RECAPTCHA_SITE_KEY = process.env.NEXT_PUBLIC_RECAPTCHA_SITE_KEY || '';

const methodLabels: Record<string, string> = {
  mobile: 'Mobile Banking (bKash / Nagad / Rocket)',
