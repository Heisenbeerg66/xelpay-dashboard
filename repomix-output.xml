@import "tailwindcss";

/* ✅ Tailwind v4 Manual Dark Mode Config (এটি না থাকলে বাটন কাজ করবে না) */
@variant dark (&:is(.dark *));

@theme {
  /* আপনার কোডে ব্যবহৃত ব্লু থিম সেটআপ */
  --color-blue-50: #eff6ff;
  --color-blue-100: #dbeafe;
  --color-blue-600: #2563eb;
  --color-blue-700: #1d4ed8;
  --color-blue-50: #eff6ff;
  --color-blue-100: #dbeafe;
  --color-blue-600: #2563eb;
  --color-blue-700: #1d4ed8;
  --color-slate-900: #0f172a;
  --color-slate-950: #020617;

  /* ডার্ক মোডের স্লেট থিম */
  --color-slate-900: #0f172a;
  --color-slate-950: #020617;
}

@layer base {
  :root {
    --background: #ffffff;
    --foreground: #0f172a;
    --card: #ffffff;
    --card-foreground: #0f172a;
    --popover: #ffffff;
    --popover-foreground: #0f172a;
    --primary: #2563eb; /* Blue 600 */
    --primary-foreground: #ffffff;
    --secondary: #f1f5f9;
    --secondary-foreground: #0f172a;
    --muted: #f8fafc;
    --muted-foreground: #64748b;
    --accent: #f1f5f9;
    --accent-foreground: #0f172a;
    --destructive: #ef4444;
    --destructive-foreground: #ffffff;
    --border: #e2e8f0;
    --input: #e2e8f0;
    --ring: #2563eb;
    --radius: 0.75rem;
    /* Settings-specific spacing */
    --settings-sidebar-width: 15rem;
    --settings-content-max-width: 48rem;
    --settings-card-radius: 1rem;

    /* Elevated surfaces */
    --surface-elevated: #ffffff;
    --surface-sunken: #f8fafc;

    /* Interactive states */
    --hover-bg: rgba(0, 0, 0, 0.04);
    --active-bg: rgba(0, 0, 0, 0.07);

    /* Status colors — semantic */
    --status-success: #10b981;
    --status-warning: #f59e0b;
    --status-error: #ef4444;
    --status-info: #3b82f6;
  }

  .dark {
     --surface-elevated: #0f172a;
    --surface-sunken: #0B1120;

    --hover-bg: rgba(255, 255, 255, 0.05);
    --active-bg: rgba(255, 255, 255, 0.09);

    --status-success: #34d399;
    --status-warning: #fbbf24;
    --status-error: #f87171;
    --status-info: #60a5fa;
    --background: #0B1120; /* প্রিমিয়াম নেভি ব্ল্যাক */
    --foreground: #f8fafc;
    --card: #0f172a;
    --card-foreground: #f8fafc;
    --popover: #0f172a;
    --popover-foreground: #f8fafc;
    --primary: #3b82f6;
    --primary-foreground: #ffffff;
    --secondary: #1e293b;
    --secondary-foreground: #f8fafc;
    --muted: #0f172a;
    --muted-foreground: #94a3b8;
    --accent: #1e293b;
    --accent-foreground: #f8fafc;
    --destructive: #7f1d1d;
    --destructive-foreground: #f8fafc;
    --border: #1e293b;
    --input: #1e293b;
    --ring: #3b82f6;
  }

  body {
    @apply bg-[var(--background)] text-[var(--foreground)] antialiased transition-colors duration-300;
  }

  html {
    scroll-behavior: smooth;
  }
}
.settings-v2-root {
  --ring: var(--primary);
}

/* Smooth section transitions */
.settings-section-enter {
  animation: settings-fade-in 0.18s ease-out;
}

@keyframes settings-fade-in {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Premium scrollbar for settings */
.settings-scroll::-webkit-scrollbar {
  width: 4px;
}
.settings-scroll::-webkit-scrollbar-track {
  background: transparent;
}
.settings-scroll::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 99px;
}
.settings-scroll::-webkit-scrollbar-thumb:hover {
  background: var(--muted-foreground);
}
